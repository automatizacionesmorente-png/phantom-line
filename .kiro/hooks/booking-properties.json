{
  "version": "v1",
  "hooks": [
    {
      "name": "booking-properties-on-save",
      "trigger": "PostFileSave",
      "matcher": "lib/booking/.*\\.ts$",
      "action": { "type": "command", "command": "npx vitest run tests/booking --maxWorkers=2 --reporter=dot" },
      "timeout": 240,
      "enabled": true
    },
    {
      "name": "guard-secrets",
      "trigger": "PreToolUse",
      "matcher": "read|write|shell",
      "action": { "type": "command", "command": "node .kiro/hooks/scripts/guard-secrets.mjs" },
      "timeout": 10,
      "enabled": true
    }
  ]
}
